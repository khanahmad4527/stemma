# Every dependency is pinned to one exact version — no carets, no
# tildes. `pnpm add x` would otherwise write `^1.2.3` and quietly
# reintroduce the drift, so the default is changed rather than left to
# whoever runs the command next.
save-exact=true

# Refuse to install anything the lockfile does not already describe.
# A CI run that silently resolves a new transitive version is not
# reproducing the build it claims to be testing.
prefer-frozen-lockfile=true
