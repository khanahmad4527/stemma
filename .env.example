# ---- Postgres ----------------------------------------------------------
DB_DATABASE=stemma
DB_USER=stemma
DB_PASSWORD=change-me-in-production
# Published on loopback only, for the database rules in
# bootstrap/src/constraints.ts and the check suite. 9433 rather than 5432
# so this can run alongside a Postgres you already have.
DB_PORT=9433

# ---- Directus ----------------------------------------------------------
# Generate fresh values: openssl rand -hex 32
KEY=replace-with-openssl-rand-hex-32
SECRET=replace-with-openssl-rand-hex-32

DIRECTUS_PORT=9057
PUBLIC_URL=http://localhost:9057

ADMIN_EMAIL=admin@stemma.dev
ADMIN_PASSWORD=change-me-in-production

DIRECTUS_IMAGE=directus/directus:12.3.1

# Directus 12 licence key — REQUIRED for this project, not optional.
#
# At core tier 12.x refuses custom rules on access policies, and Stemma's
# public security model is exactly that: a filter saying a row is visible
# only when its tree is public and its subject is not living. Unlicensed,
# that rule cannot be created — and `d6s sync pull` against an unlicensed
# instance silently drops custom permission rules that use filters, so
# the committed sync files would be missing the only thing protecting
# living people. Fail loudly here instead.
#
# Free under the Open Innovation Grant (under $5M revenue, under 50 staff):
#   https://directus.com/docs/licensing/open-innovation-grant
#
# Never commit a real key.
DIRECTUS_LICENSE_KEY=

# ---- The check suite ---------------------------------------------------
# Every seeded account shares one password.
DEMO_PASSWORD=StemmaDemo!2026
