# The Directus this site reads. Server-side only — no browser ever sees it.
DIRECTUS_URL=http://localhost:9057

# Signs the cookie that carries a member's Directus tokens. Rotating it
# signs everyone out, which is the correct response to it leaking.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Where the site listens.
WEB_PORT=8060
